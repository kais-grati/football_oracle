# Optional; without it, bets are recorded without Discord alerts.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
TZ=Europe/Madrid
UID=1000
GID=1000
PYTHON_VERSION=3.14

# Bzzoiro: fixtures, results, and consensus 1X2 prices.
BZZOIRO-API-KEY=REPLACE_ME

# MoviOdds: Bet365 execution prices.
ODDS-API-KEY=REPLACE_ME

# Scheduler policy (defaults shown).
PAPER_LEAGUE=La Liga
PAPER_LEAGUE_ID=3
PAPER_MOVIODDS_LEAGUE=Spain La Liga
PAPER_STARTING_CAPITAL=100
PAPER_DECISION_LEAD_MINUTES=30
PAPER_SAFETY_MARGIN_MINUTES=10
PAPER_MAX_STALENESS_MINUTES=45
PAPER_FALLBACK_STAKE_MULTIPLIER=0.5
PAPER_TICK_SECONDS=30
PAPER_RETRY_INTERVAL_SECONDS=120
PAPER_SETTLEMENT_INTERVAL_SECONDS=300
PAPER_FIXTURES_REFRESH_MINUTES=360
